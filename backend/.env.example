# Copy to .env. Never commit .env. Broker credentials are NOT configured here yet (no broker adapter exists).
NIFTYPILOT_DATABASE_URL=sqlite:///./niftypilot.db
# Only "paper" is accepted; any other value fails at startup.
NIFTYPILOT_TRADING_MODE=paper
NIFTYPILOT_CORS_ORIGINS=["http://localhost:5173"]
